rules_version = '2';

// Each person's lists, templates and projects live under users/{their account id}/lists, /templates and /projects.
// A request is allowed only when it comes from a signed-in user whose account id matches that folder.
// Everything else, including anyone who isn't signed in, is refused by Google's servers.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/lists/{listId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['title', 'items', 'createdAt', 'updatedAt', 'sortedAt', 'completedAt', 'projectId'])
        && request.resource.data.title is string
        && request.resource.data.items is list;
    }
    match /users/{userId}/templates/{templateId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['title', 'items', 'createdAt', 'updatedAt', 'sortedAt'])
        && request.resource.data.title is string
        && request.resource.data.items is list;
    }
    match /users/{userId}/projects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['title', 'createdAt'])
        && request.resource.data.title is string;
    }
  }
}
